  "keywords": [
    "mouse-movement"
  ],
  "homepage": "https://github.com/puffinsoft/mousecrack#readme",
  "bugs": {
    "url": "https://github.com/puffinsoft/mousecrack/issues"
  },
  "repository": {
    "type": "git",
